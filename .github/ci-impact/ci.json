{
  "version": 1,
  "ignore_paths": [
    ".renovaterc.json5",
    "renovate.json",
    ".github/renovate.json"
  ],
  "ignore_tools": [
    "aqua:betterleaks/betterleaks",
    "aqua:evilmartians/lefthook",
    "npm:@commitlint/cli",
    "npm:@commitlint/config-conventional"
  ],
  "jobs": {
    "validate": {
      "paths": [
        ":(glob)**/*.md",
        ".markdownlint-cli2.yaml",
        ".github/workflows/ci.yaml",
        ".github/workflows/tools.yaml",
        ".github/actions/**"
      ],
      "tools": [],
      "needs": []
    },
    "workflow-quality": {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**",
        ".github/actionlint.yaml",
        ".github/actionlint.yml",
        ".github/zizmor.yaml",
        ".shellcheckrc",
        ".github/workflows/ci.yaml",
        ".github/workflows/tools.yaml"
      ],
      "tools": [
        "python",
        "aqua:kjanat/actionlint",
        "aqua:rhysd/actionlint",
        "aqua:zizmorcore/zizmor",
        "aqua:koalaman/shellcheck"
      ],
      "needs": []
    }
  }
}
